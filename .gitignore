# ============================================================
# Federal Spending Analytics - Power BI (PBIP) project
# Tracked: *.pbip, *.pbir, *.pbism, *.tmdl, report/page JSON,
#          .platform, StaticResources, .pbi/editorSettings.json,
#          and project documentation (*.md, docs/)
# ============================================================

# ---- Power BI local cache & user-specific settings ----------
**/.pbi/localSettings.json
**/.pbi/cache.abf
**/.pbi/*.abf
**/.pbi/*.tmp

# ---- Data files (USAspending raw & processed extracts) ------
data/raw/
data/processed/
*.csv
*.csv.gz
*.zip
*.parquet
# Allow small, curated sample files for reviewers, if added later
!data/sample/
!data/sample/*.csv
# Explicit, case-exact exclusion of the local Data/ folder (Data/Raw, Data/Processed), so it stays
# ignored on case-sensitive systems too. Data/* (not Data/) keeps the sample-folder exception working.
Data/*
!Data/sample/
!Data/sample/*.csv

# ---- Credentials & environment files ------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets/
credentials*.json
*.secret

# ---- Temporary files & logs ---------------------------------
*.tmp
*.temp
*.bak
*.swp
~$*
*.log
logs/
tmp/
temp/

# ---- Local notes (e.g. expiring USAspending download links) --
fed-spend*.txt
notes/

# ---- OS / editor clutter ------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# ---- Python tooling (if used for data prep) -----------------
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
