expression DataFolderPath = "C:\Projects\Federal-Spending-Analytics\Data\Raw\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: b3fd6733-8d37-4222-bb6d-33b16598791f

	annotation PBI_ResultType = Text

expression stg_ContractTransactions =
		let
		    // All prime-transaction CSVs in the raw folder (USAspending splits large downloads into _1, _2, ...)
		    Files = Folder.Files(DataFolderPath),
		    ContractFiles = Table.SelectRows(Files, each Text.StartsWith([Name], "Contracts_PrimeTransactions") and Text.Lower([Extension]) = ".csv"),
		    SelectedColumns = {
		    "contract_transaction_unique_key",
		    "contract_award_unique_key",
		    "award_id_piid",
		    "modification_number",
		    "parent_award_id_piid",
		    "federal_action_obligation",
		    "total_dollars_obligated",
		    "current_total_value_of_award",
		    "potential_total_value_of_award",
		    "action_date",
		    "action_date_fiscal_year",
		    "period_of_performance_start_date",
		    "period_of_performance_current_end_date",
		    "awarding_agency_code",
		    "awarding_agency_name",
		    "awarding_sub_agency_code",
		    "awarding_sub_agency_name",
		    "awarding_office_code",
		    "awarding_office_name",
		    "funding_agency_code",
		    "funding_agency_name",
		    "funding_sub_agency_code",
		    "funding_sub_agency_name",
		    "recipient_uei",
		    "recipient_name",
		    "recipient_parent_uei",
		    "recipient_parent_name",
		    "recipient_city_name",
		    "recipient_state_code",
		    "primary_place_of_performance_state_code",
		    "primary_place_of_performance_state_name",
		    "primary_place_of_performance_country_code",
		    "naics_code",
		    "naics_description",
		    "product_or_service_code",
		    "product_or_service_code_description",
		    "award_type_code",
		    "award_type",
		    "type_of_contract_pricing_code",
		    "type_of_contract_pricing",
		    "extent_competed_code",
		    "extent_competed",
		    "type_of_set_aside_code",
		    "type_of_set_aside",
		    "contracting_officers_determination_of_business_size_code",
		    "contracting_officers_determination_of_business_size",
		    "number_of_offers_received",
		    "action_type_code",
		    "action_type",
		    "transaction_description",
		    "usaspending_permalink",
		    "last_modified_date"
		    },
		    Parsed = Table.AddColumn(ContractFiles, "Data", each Table.SelectColumns(
		        Table.PromoteHeaders(Csv.Document([Content], [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true]),
		        SelectedColumns)),
		    Combined = Table.Combine(Parsed[Data]),
		    // Source format is "yyyy-MM-dd HH:mm:ss+00"; keep the date part only
		    LastModifiedAsDate = Table.TransformColumns(Combined, {{"last_modified_date", each if _ = null or _ = "" then null else Date.FromText(Text.Start(_, 10)), type date}}),
		    Typed = Table.TransformColumnTypes(LastModifiedAsDate, {
		    {"contract_transaction_unique_key", type text},
		    {"contract_award_unique_key", type text},
		    {"award_id_piid", type text},
		    {"modification_number", type text},
		    {"parent_award_id_piid", type text},
		    {"federal_action_obligation", Currency.Type},
		    {"total_dollars_obligated", Currency.Type},
		    {"current_total_value_of_award", Currency.Type},
		    {"potential_total_value_of_award", Currency.Type},
		    {"action_date", type date},
		    {"action_date_fiscal_year", Int64.Type},
		    {"period_of_performance_start_date", type date},
		    {"period_of_performance_current_end_date", type date},
		    {"awarding_agency_code", type text},
		    {"awarding_agency_name", type text},
		    {"awarding_sub_agency_code", type text},
		    {"awarding_sub_agency_name", type text},
		    {"awarding_office_code", type text},
		    {"awarding_office_name", type text},
		    {"funding_agency_code", type text},
		    {"funding_agency_name", type text},
		    {"funding_sub_agency_code", type text},
		    {"funding_sub_agency_name", type text},
		    {"recipient_uei", type text},
		    {"recipient_name", type text},
		    {"recipient_parent_uei", type text},
		    {"recipient_parent_name", type text},
		    {"recipient_city_name", type text},
		    {"recipient_state_code", type text},
		    {"primary_place_of_performance_state_code", type text},
		    {"primary_place_of_performance_state_name", type text},
		    {"primary_place_of_performance_country_code", type text},
		    {"naics_code", type text},
		    {"naics_description", type text},
		    {"product_or_service_code", type text},
		    {"product_or_service_code_description", type text},
		    {"award_type_code", type text},
		    {"award_type", type text},
		    {"type_of_contract_pricing_code", type text},
		    {"type_of_contract_pricing", type text},
		    {"extent_competed_code", type text},
		    {"extent_competed", type text},
		    {"type_of_set_aside_code", type text},
		    {"type_of_set_aside", type text},
		    {"contracting_officers_determination_of_business_size_code", type text},
		    {"contracting_officers_determination_of_business_size", type text},
		    {"number_of_offers_received", Int64.Type},
		    {"action_type_code", type text},
		    {"action_type", type text},
		    {"transaction_description", type text},
		    {"usaspending_permalink", type text}
		    }, "en-US")
		in
		    Typed
	lineageTag: 3e44cf22-3e93-445a-8eb1-790121f419d4

	annotation PBI_ResultType = Table

