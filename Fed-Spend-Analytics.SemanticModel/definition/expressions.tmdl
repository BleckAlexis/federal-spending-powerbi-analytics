expression DataFolderPath = "C:\Projects\Federal-Spending-Analytics\Data\Processed\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: b3fd6733-8d37-4222-bb6d-33b16598791f

	annotation PBI_ResultType = Text

expression stg_ContractTransactions =
		let
		    // Slim extract produced by scripts/prepare_data.py from the raw USAspending CSVs
		    Source = Csv.Document(File.Contents(DataFolderPath & "contract_transactions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    SelectedColumns = {
		        "contract_transaction_unique_key",
		        "contract_award_unique_key",
		        "award_id_piid",
		        "modification_number",
		        "parent_award_id_piid",
		        "federal_action_obligation",
		        "action_date",
		        "period_of_performance_start_date",
		        "period_of_performance_current_end_date",
		        "awarding_agency_code",
		        "awarding_agency_name",
		        "awarding_sub_agency_code",
		        "awarding_sub_agency_name",
		        "awarding_office_code",
		        "awarding_office_name",
		        "recipient_uei",
		        "recipient_name",
		        "recipient_parent_uei",
		        "recipient_parent_name",
		        "recipient_city_name",
		        "recipient_state_code",
		        "primary_place_of_performance_state_code",
		        "primary_place_of_performance_state_name",
		        "primary_place_of_performance_country_code",
		        "primary_place_of_performance_country_name",
		        "naics_code",
		        "naics_description",
		        "product_or_service_code",
		        "product_or_service_code_description",
		        "award_type_code",
		        "award_type",
		        "type_of_contract_pricing_code",
		        "type_of_contract_pricing",
		        "extent_competed_code",
		        "extent_competed",
		        "type_of_set_aside_code",
		        "type_of_set_aside",
		        "contracting_officers_determination_of_business_size_code",
		        "contracting_officers_determination_of_business_size",
		        "number_of_offers_received",
		        "action_type_code",
		        "action_type",
		        "transaction_description",
		        "last_modified_date"
		    },
		    Combined = Table.SelectColumns(Promoted, SelectedColumns),
		    // Source format is "yyyy-MM-dd HH:mm:ss+00"; keep the date part only
		    LastModifiedAsDate = Table.TransformColumns(Combined, {{"last_modified_date", each if _ = null or _ = "" then null else Date.FromText(Text.Start(_, 10)), type date}}),
		    Typed = Table.TransformColumnTypes(LastModifiedAsDate, {
		        {"contract_transaction_unique_key", type text},
		        {"contract_award_unique_key", type text},
		        {"award_id_piid", type text},
		        {"modification_number", type text},
		        {"parent_award_id_piid", type text},
		        {"federal_action_obligation", Currency.Type},
		        {"action_date", type date},
		        {"period_of_performance_start_date", type date},
		        {"period_of_performance_current_end_date", type date},
		        {"awarding_agency_code", type text},
		        {"awarding_agency_name", type text},
		        {"awarding_sub_agency_code", type text},
		        {"awarding_sub_agency_name", type text},
		        {"awarding_office_code", type text},
		        {"awarding_office_name", type text},
		        {"recipient_uei", type text},
		        {"recipient_name", type text},
		        {"recipient_parent_uei", type text},
		        {"recipient_parent_name", type text},
		        {"recipient_city_name", type text},
		        {"recipient_state_code", type text},
		        {"primary_place_of_performance_state_code", type text},
		        {"primary_place_of_performance_state_name", type text},
		        {"primary_place_of_performance_country_code", type text},
		        {"primary_place_of_performance_country_name", type text},
		        {"naics_code", type text},
		        {"naics_description", type text},
		        {"product_or_service_code", type text},
		        {"product_or_service_code_description", type text},
		        {"award_type_code", type text},
		        {"award_type", type text},
		        {"type_of_contract_pricing_code", type text},
		        {"type_of_contract_pricing", type text},
		        {"extent_competed_code", type text},
		        {"extent_competed", type text},
		        {"type_of_set_aside_code", type text},
		        {"type_of_set_aside", type text},
		        {"contracting_officers_determination_of_business_size_code", type text},
		        {"contracting_officers_determination_of_business_size", type text},
		        {"number_of_offers_received", Int64.Type},
		        {"action_type_code", type text},
		        {"action_type", type text},
		        {"transaction_description", type text}
		    }, "en-US"),
		
		    // ---- Dimension keys: trimmed + upper-cased (VertiPaq keys are case-insensitive); blanks -> UNKNOWN
		    Norm = (v as nullable text) as text => if v = null then "" else Text.Upper(Text.Trim(v)),
		    OrUnknown = (k as text) as text => if k = "" or List.MatchesAll(Text.Split(k, "|"), each _ = "") then "UNKNOWN" else k,
		    AddAgencyKey = Table.AddColumn(Typed, "AgencyKey", each OrUnknown(Norm([awarding_sub_agency_code]) & "|" & Norm([awarding_office_code])), type text),
		    AddRecipientKey = Table.AddColumn(AddAgencyKey, "RecipientKey", each OrUnknown(Norm([recipient_uei])), type text),
		    AddNAICSKey = Table.AddColumn(AddRecipientKey, "NAICSKey", each OrUnknown(Norm([naics_code])), type text),
		    AddPSCKey = Table.AddColumn(AddNAICSKey, "PSCKey", each OrUnknown(Norm([product_or_service_code])), type text),
		    AddPlaceKey = Table.AddColumn(AddPSCKey, "PlaceKey", each OrUnknown(Norm([primary_place_of_performance_country_code]) & "|" & Norm([primary_place_of_performance_state_code])), type text),
		    AddContractTypeKey = Table.AddColumn(AddPlaceKey, "ContractTypeKey", each Text.Combine(List.Transform({
		        [award_type_code], [type_of_contract_pricing_code], [extent_competed_code],
		        [type_of_set_aside_code], [contracting_officers_determination_of_business_size_code], [action_type_code]
		    }, Norm), "|"), type text)
		in
		    AddContractTypeKey
	lineageTag: 3e44cf22-3e93-445a-8eb1-790121f419d4

	annotation PBI_ResultType = Table

expression fnLatestByKey =
		// Builds a conformed dimension: one row per key, attributes taken from the most recent
		// transaction (Type 1), plus exactly one explicit UNKNOWN member.
		(Source as table, KeyColumn as text, SourceColumns as list, OutputNames as list, UnknownValues as list) as table =>
		let
		    Grouped = Table.Group(Source, {KeyColumn}, {{"Latest", each Table.Max(_, "action_date"), type record}}),
		    Expanded = Table.ExpandRecordColumn(Grouped, "Latest", SourceColumns, OutputNames),
		    Known = Table.SelectRows(Expanded, each Record.Field(_, KeyColumn) <> "UNKNOWN"),
		    Unknown = #table(Table.ColumnNames(Known), {{"UNKNOWN"} & UnknownValues}),
		    Combined = Table.Combine({Known, Unknown}),
		    Typed = Table.TransformColumnTypes(Combined, List.Transform(Table.ColumnNames(Combined), each {_, type text}))
		in
		    Typed
	lineageTag: e7f30b95-af3c-4ebb-aec6-bd8e77e1445b

	annotation PBI_ResultType = Function

