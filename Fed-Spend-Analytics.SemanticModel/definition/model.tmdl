model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DataFolderPath","fnLatestByKey","stg_ContractTransactions","FactContractTransactions","DimAgency","DimRecipient","DimNAICS","DimPSC","DimPlaceOfPerformance","DimContractType","_Measures"]

ref table FactContractTransactions
ref table DimDate
ref table DimAgency
ref table DimRecipient
ref table DimNAICS
ref table DimPSC
ref table DimPlaceOfPerformance
ref table DimContractType
ref table _Measures

ref cultureInfo en-US

