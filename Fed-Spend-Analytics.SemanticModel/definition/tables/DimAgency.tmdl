	partition DimAgency = m
		mode: import
		source =
				let
				    Source = stg_ContractTransactions,
				    Base = fnLatestByKey(Source, "AgencyKey",
				        {"awarding_agency_code", "awarding_agency_name", "awarding_sub_agency_code", "awarding_sub_agency_name", "awarding_office_code", "awarding_office_name"},
				        {"Agency Code", "Agency Name", "Sub-Agency Code", "Sub-Agency Name", "Office Code", "Office Name"},
