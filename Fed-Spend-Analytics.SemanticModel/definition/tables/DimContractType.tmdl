	partition DimContractType = m
		mode: import
		source =
				let
				    Source = stg_ContractTransactions,
				    Base = fnLatestByKey(Source, "ContractTypeKey",
				        {"award_type_code", "award_type", "type_of_contract_pricing_code", "type_of_contract_pricing", "extent_competed_code", "extent_competed", "type_of_set_aside_code", "type_of_set_aside", "contracting_officers_determination_of_business_size_code", "contracting_officers_determination_of_business_size", "action_type_code", "action_type"},
				        {"Award Type Code", "Award Type", "Pricing Code", "Contract Pricing", "Extent Competed Code", "Extent Competed", "Set-Aside Code", "Set-Aside", "Business Size Code", "Business Size", "Action Type Code", "Action Type"},
				        {"", "Unknown", "", "Unknown", "", "Unknown", "", "Unknown", "", "Unknown", "", "Unknown"}),
				    // Blank action type = modification 0 (verified in source: 57,276 of 57,276 rows)
				    Labels = Table.FromRecords(Table.TransformRows(Base, each _ & [
				        #"Action Type" = if _[#"Action Type Code"] = "" and _[ContractTypeKey] <> "UNKNOWN" then "BASE AWARD" else _[#"Action Type"],
				        #"Contract Pricing" = if _[#"Contract Pricing"] = "" then "NOT REPORTED" else _[#"Contract Pricing"],
				        #"Extent Competed" = if _[#"Extent Competed"] = "" then "NOT REPORTED" else _[#"Extent Competed"],
				        #"Set-Aside" = if _[#"Set-Aside"] = "" then "NOT REPORTED" else _[#"Set-Aside"],
				        #"Business Size" = if _[#"Business Size"] = "" then "NOT REPORTED" else _[#"Business Size"]
				    ])),
				    Typed = Table.TransformColumnTypes(Labels, List.Transform(Table.ColumnNames(Labels), each {_, type text})),
				    AddCompetition = Table.AddColumn(Typed, "Competition Status", each
				        if List.Contains({"A", "D", "F", "CDO"}, [Extent Competed Code]) then "Competed"
				        else if [Extent Competed Code] = "" then "Not Reported" else "Not Competed", type text),
				    AddSetAside = Table.AddColumn(AddCompetition, "Set-Aside Status", each
				        if [#"Set-Aside Code"] = "" then "Not Reported" else if [#"Set-Aside Code"] = "NONE" then "No Set-Aside" else "Set-Aside", type text),
				    AddSmallBusiness = Table.AddColumn(AddSetAside, "Small Business Flag", each
				        if [Business Size Code] = "S" then "Small Business" else if [Business Size Code] = "O" then "Other Than Small" else "Not Reported", type text)
				in
				    AddSmallBusiness

	annotation PBI_ResultType = Table

