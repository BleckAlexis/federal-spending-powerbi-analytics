	column 'Calendar Year'
		dataType: int64
		formatString: 0
		lineageTag: 5111be13-8941-477d-b8bb-e39ab90ceb88
		summarizeBy: none
		isNameInferred
		sourceColumn: [Calendar Year]

		annotation SummarizationSetBy = Automatic

	column 'Year Month'
		dataType: string
		lineageTag: bf8a1fb1-3bd3-4ef6-99c1-d4a10052242f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]

		annotation SummarizationSetBy = Automatic

	column 'Month Start'
		dataType: dateTime
		formatString: Short Date
		lineageTag: d98698ec-5722-4785-9835-cde9ca90ebbd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Start]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	hierarchy 'Fiscal Calendar'
		lineageTag: 35a8ba9e-69c9-4775-96e2-d4f4ad70b07f

		level 'Fiscal Year'
			lineageTag: 2a91cb9f-22b8-42ce-a410-6545a23d554e
			column: 'Fiscal Year'

		level 'Fiscal Quarter'
			lineageTag: 2fe7159e-9029-4286-96cc-7b43b8e6da3d
			column: 'Fiscal Quarter'

		level Month
			lineageTag: cedbba90-ffb9-427d-be62-3328d24f2156
			column: 'Month Name'

		level Date
			lineageTag: a4abacb0-3059-43d7-9679-695240ab2d1c
			column: Date

	partition DimDate = calculated
		mode: import
		source =
				VAR MinDate = MIN ( FactContractTransactions[Action Date] )
				VAR MaxDate = MAX ( FactContractTransactions[Action Date] )
				VAR StartDate = DATE ( YEAR ( MinDate ) - IF ( MONTH ( MinDate ) < 10, 1, 0 ), 10, 1 )
				VAR EndDate = DATE ( YEAR ( MaxDate ) + IF ( MONTH ( MaxDate ) >= 10, 1, 0 ), 9, 30 )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( StartDate, EndDate ),
				        "Fiscal Year Number", YEAR ( [Date] ) + IF ( MONTH ( [Date] ) >= 10, 1, 0 ),
				        "Fiscal Year", "FY" & ( YEAR ( [Date] ) + IF ( MONTH ( [Date] ) >= 10, 1, 0 ) ),
				        "Fiscal Quarter Number", QUOTIENT ( MOD ( MONTH ( [Date] ) + 2, 12 ), 3 ) + 1,
				        "Fiscal Quarter", "Q" & ( QUOTIENT ( MOD ( MONTH ( [Date] ) + 2, 12 ), 3 ) + 1 ),
				        "Fiscal Year Quarter Number", ( YEAR ( [Date] ) + IF ( MONTH ( [Date] ) >= 10, 1, 0 ) ) * 10 + QUOTIENT ( MOD ( MONTH ( [Date] ) + 2, 12 ), 3 ) + 1,
				        "Fiscal Year Quarter", "FY" & ( YEAR ( [Date] ) + IF ( MONTH ( [Date] ) >= 10, 1, 0 ) ) & " Q" & ( QUOTIENT ( MOD ( MONTH ( [Date] ) + 2, 12 ), 3 ) + 1 ),
				        "Fiscal Month Number", MOD ( MONTH ( [Date] ) + 2, 12 ) + 1,
				        "Month Name", FORMAT ( [Date], "MMMM" ),
				        "Month Short", FORMAT ( [Date], "MMM" ),
				        "Calendar Year", YEAR ( [Date] ),
				        "Year Month", FORMAT ( [Date], "YYYY-MM" ),
				        "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 )
				    )

