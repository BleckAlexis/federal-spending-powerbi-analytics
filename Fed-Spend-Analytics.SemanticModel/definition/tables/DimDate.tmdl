	column 'Month Short'
		dataType: string
		lineageTag: e296fcba-6f3a-48c0-b2c8-c801e4c1219f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Short]
		sortByColumn: 'Fiscal Month Number'

