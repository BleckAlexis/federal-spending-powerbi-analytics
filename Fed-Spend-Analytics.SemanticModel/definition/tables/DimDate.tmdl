	column 'Month Name'
		dataType: string
		lineageTag: 6d8ab7ed-e4ce-4226-a2b2-c47a46a14ead
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Name]
		sortByColumn: 'Fiscal Month Number'

