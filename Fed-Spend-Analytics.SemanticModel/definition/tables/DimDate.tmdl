	column 'Fiscal Year Quarter Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4379b8da-3e37-4df1-97a3-f50855832246
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Year Quarter Number]

		annotation SummarizationSetBy = Automatic

	column 'Fiscal Year Quarter'
		dataType: string
		lineageTag: dafd231a-5dd9-417c-852f-5ee8528a6c70
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Year Quarter]
		sortByColumn: 'Fiscal Year Quarter Number'

		annotation SummarizationSetBy = Automatic

	column 'Fiscal Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6b8c4da6-2a41-4834-95e1-dd3bc404a7d0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Month Number]

