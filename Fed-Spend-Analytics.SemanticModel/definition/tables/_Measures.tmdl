/// Home table for all report measures.
table _Measures
	lineageTag: 79fac1ab-9299-40d2-b780-4d2447ebf816

	/// Primary financial measure: sum of federal_action_obligation including negative de-obligations.
	measure 'Net Obligations' = SUM ( FactContractTransactions[Federal Action Obligation] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Obligations
		lineageTag: fd8851c7-87e0-4471-93d5-d3a6f6ce54a3

	/// Positive obligations only.
	measure 'Gross Obligations' = CALCULATE ( [Net Obligations], FactContractTransactions[Federal Action Obligation] > 0 )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Obligations
		lineageTag: 524f5996-be26-4dcd-9a53-144f9eade491

	/// Negative obligations only (shown as negative values).
	measure Deobligations = CALCULATE ( [Net Obligations], FactContractTransactions[Federal Action Obligation] < 0 )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Obligations
		lineageTag: aa9b34f3-b73c-4649-a23c-29cbef6b2268

	/// Net Obligations divided by the number of distinct awards with at least one transaction in the current filter context.
	/// Includes continuing awards (modifications, option exercises), not only new awards; net of de-obligations, so it can be negative.
	measure 'Avg Net Obligation per Award' = DIVIDE ( [Net Obligations], [Awards] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Obligations
		lineageTag: 19be6086-7652-40ab-9d7a-7741f4ee3f8e

	/// Number of contract transactions (actions), including modifications and zero-dollar administrative actions.
	measure Transactions = COUNTROWS ( FactContractTransactions )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 03376afe-d816-4202-aea2-7d8d656a296c

	/// Distinct awards with at least one transaction in the current filter context (new and continuing).
	measure Awards = DISTINCTCOUNT ( FactContractTransactions[Award Key] )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 9383da2a-18c8-41d6-bfc6-0f7d06290675

	/// Distinct recipient UEIs with at least one transaction in the current filter context.
	measure Recipients = DISTINCTCOUNT ( FactContractTransactions[RecipientKey] )
		formatString: #,0
		displayFolder: Volume
		lineageTag: c2a4865b-40d8-44ad-8d9e-8f2f698182be

	/// Fiscal year-to-date (federal fiscal year Oct 1 - Sep 30). Blank when more than one fiscal year is in context.
	measure 'Net Obligations FYTD' =
			IF (
			    HASONEVALUE ( DimDate[Fiscal Year Number] ),
			    TOTALYTD ( [Net Obligations], DimDate[Date], "09-30" )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time Intelligence
		lineageTag: d7a6b2b5-9d0a-448e-b431-e9bd0ed85160

	/// Net Obligations for the same period one fiscal year earlier. Blank when more than one fiscal year is in context
	/// (e.g. a grand total across FY2023-FY2025), so multi-year totals never show a misleading comparison.
	measure 'Net Obligations PY' =
			IF (
			    HASONEVALUE ( DimDate[Fiscal Year Number] ),
			    CALCULATE ( [Net Obligations], SAMEPERIODLASTYEAR ( DimDate[Date] ) )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time Intelligence
		lineageTag: 0b5c062e-3199-45f8-96c3-872fbb7b1050

	/// Change in Net Obligations vs. the prior fiscal year. Blank when there is no prior-year value or more than one fiscal year is in context.
	measure 'Net Obligations YoY' =
			VAR Curr = [Net Obligations]
			VAR Prev = [Net Obligations PY]
			RETURN
			    IF ( NOT ISBLANK ( Prev ), Curr - Prev )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Time Intelligence
		lineageTag: 8fc89d19-c63c-41d7-96b7-31928e3f2852

	/// Percent change in Net Obligations vs. the prior fiscal year. Blank for FY2023 (no FY2022 data) and for multi-year totals.
	measure 'Net Obligations YoY %' = DIVIDE ( [Net Obligations YoY], [Net Obligations PY] )
		formatString: 0.0%
		displayFolder: Time Intelligence
		lineageTag: 96ec8862-f682-4da2-a875-5b9e2caeec9d

	/// Net Obligations as a share of the visual's total (ALLSELECTED). Based on net amounts, so a share can fall
	/// outside 0-100% in slices where de-obligations exceed new obligations.
	measure '% of Total Obligations' = DIVIDE ( [Net Obligations], CALCULATE ( [Net Obligations], ALLSELECTED () ) )
		formatString: 0.0%
		displayFolder: Mix
		lineageTag: 5abd1f85-1c75-4b9c-ae47-d52fd2db4876

	/// Net Obligations to small businesses (contracting officer's size determination = S) / all Net Obligations.
	/// Net-based, consistent with USAspending; can fall outside 0-100% in slices dominated by de-obligations.
	measure 'Small Business Share' = DIVIDE ( CALCULATE ( [Net Obligations], DimContractType[Small Business Flag] = "Small Business" ), [Net Obligations] )
		formatString: 0.0%
		displayFolder: Mix
		lineageTag: 02a62ea7-3a80-4b96-af1f-2c08b19fd73b

	/// Net Obligations on competed actions (extent competed A, D, F or CDO) / all Net Obligations.
	/// Net-based; can fall outside 0-100% in slices dominated by de-obligations.
	measure 'Competed Share' = DIVIDE ( CALCULATE ( [Net Obligations], DimContractType[Competition Status] = "Competed" ), [Net Obligations] )
		formatString: 0.0%
		displayFolder: Mix
		lineageTag: ef396663-f4b3-4e26-8e89-f773424610c8

	/// Net Obligations on actions with a set-aside (set-aside code other than NONE or blank) / all Net Obligations.
	/// Blank set-aside = not reported (typical for orders, which inherit it from the parent contract) and is not counted as a set-aside.
	measure 'Set-Aside Share' = DIVIDE ( CALCULATE ( [Net Obligations], DimContractType[Set-Aside Status] = "Set-Aside" ), [Net Obligations] )
		formatString: 0.0%
		displayFolder: Mix
		lineageTag: 68153d6e-d903-4c14-9226-c4dd4b7a386a

	/// Rank (1 = highest) of Net Obligations by recipient NAME among the names visible in the visual (ALLSELECTED).
	/// Names shared by several UEIs (e.g. LEIDOS, INC. has 12) are ranked as one. Blank unless Recipient Name is on the visual.
	/// Ties share a rank. For company-level concentration use Top 10 Recipient Share (parent UEI).
	measure 'Recipient Rank' =
			IF (
			    ISINSCOPE ( DimRecipient[Recipient Name] ),
			    RANKX ( ALLSELECTED ( DimRecipient[Recipient Name] ), [Net Obligations] )
			)
		formatString: 0
		displayFolder: Mix
		lineageTag: c3e71d6b-9c42-4192-a443-c7b9a1a74fac

	/// Expected 0.
	measure 'DQ Duplicate Transaction Keys' = COUNTROWS ( FactContractTransactions ) - DISTINCTCOUNT ( FactContractTransactions[Transaction Key] )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 8246a66a-1340-42ea-90b5-c601c259eb1f

	/// Fact keys with no matching dimension row, summed across all dimensions. Expected 0.
	measure 'DQ Orphan Keys' =
			COUNTROWS ( EXCEPT ( VALUES ( FactContractTransactions[AgencyKey] ), VALUES ( DimAgency[AgencyKey] ) ) )
			    + COUNTROWS ( EXCEPT ( VALUES ( FactContractTransactions[RecipientKey] ), VALUES ( DimRecipient[RecipientKey] ) ) )
			    + COUNTROWS ( EXCEPT ( VALUES ( FactContractTransactions[NAICSKey] ), VALUES ( DimNAICS[NAICSKey] ) ) )
			    + COUNTROWS ( EXCEPT ( VALUES ( FactContractTransactions[PSCKey] ), VALUES ( DimPSC[PSCKey] ) ) )
			    + COUNTROWS ( EXCEPT ( VALUES ( FactContractTransactions[PlaceKey] ), VALUES ( DimPlaceOfPerformance[PlaceKey] ) ) )
			    + COUNTROWS ( EXCEPT ( VALUES ( FactContractTransactions[ContractTypeKey] ), VALUES ( DimContractType[ContractTypeKey] ) ) )
			    + 0
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 0c13206c-0358-46c0-b9da-05c4f625ed87

	measure 'DQ Unknown NAICS %' = DIVIDE ( CALCULATE ( [Transactions], DimNAICS[NAICSKey] = "UNKNOWN" ), [Transactions] )
		formatString: 0.0%
		displayFolder: Data Quality
		lineageTag: 9081878a-4f5f-46b7-ba12-12e8cc79104a

	measure 'DQ Unknown PSC %' = DIVIDE ( CALCULATE ( [Transactions], DimPSC[PSCKey] = "UNKNOWN" ), [Transactions] )
		formatString: 0.0%
		displayFolder: Data Quality
		lineageTag: ad70f977-91e2-4507-b724-ef662f56d830

	measure 'DQ Deobligation Rows' = CALCULATE ( [Transactions], FactContractTransactions[Federal Action Obligation] < 0 )
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 9930464a-3eb4-4787-8031-257a13387c55

	measure 'DQ Min Action Date' = MIN ( FactContractTransactions[Action Date] )
		formatString: Short Date
		displayFolder: Data Quality
		lineageTag: 4864ce33-34a8-413e-a99e-e24565529984

	measure 'DQ Max Action Date' = MAX ( FactContractTransactions[Action Date] )
		formatString: Short Date
		displayFolder: Data Quality
		lineageTag: c00c7219-1a37-4f16-9988-c38a9ce22a82

	/// Distinct awards whose base action (modification 0) was signed in the current filter context.
	/// Counts each award once, in the fiscal year its base action was signed. Awards signed before FY2023 are continuing, not new.
	measure 'New Awards' =
			CALCULATE (
			    DISTINCTCOUNT ( FactContractTransactions[Award Key] ),
			    FactContractTransactions[Is Base Action] = TRUE ()
			)
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 3b8e5d2a-6c41-4f0e-9a7d-1e2f4c5b6a71

	/// De-obligated dollars as a share of gross (positive) obligations: -Deobligations / Gross Obligations.
	measure 'Deobligation Rate' = DIVIDE ( - [Deobligations], [Gross Obligations] )
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 7c2d9e4f-1a3b-4c5d-8e6f-2a3b4c5d6e72

	/// Average number of offers on base award actions with a reported offer count of 1 or more.
	/// Base actions only (modifications repeat the base value); blank counts (delivery orders/BPA calls report offers on the parent IDV) are excluded.
	measure 'Avg Offers Received' =
			CALCULATE (
			    AVERAGE ( FactContractTransactions[Offers Received] ),
			    FactContractTransactions[Is Base Action] = TRUE (),
			    FactContractTransactions[Offers Received] >= 1
			)
		formatString: #,0.0
		displayFolder: KPIs
		lineageTag: 9e4f1b6a-3c5d-4e7f-a081-4c5d6e7f8a73

	/// Denominator of Single-Offer Rate: competed (A, D, F, CDO) awards whose base action is in context and reports 1+ offers.
	measure 'Single-Offer Eligible Awards' =
			CALCULATE (
			    DISTINCTCOUNT ( FactContractTransactions[Award Key] ),
			    FactContractTransactions[Is Base Action] = TRUE (),
			    FactContractTransactions[Offers Received] >= 1,
			    DimContractType[Competition Status] = "Competed"
			)
		formatString: #,0
		displayFolder: KPIs\Support
		lineageTag: 1f6a3d8c-5e7f-4a91-b2c3-6e7f8a9b0c74

	/// Numerator of Single-Offer Rate: eligible competed awards that received exactly one offer.
	measure 'Single-Offer Awards' =
			CALCULATE (
			    DISTINCTCOUNT ( FactContractTransactions[Award Key] ),
			    FactContractTransactions[Is Base Action] = TRUE (),
			    FactContractTransactions[Offers Received] = 1,
			    DimContractType[Competition Status] = "Competed"
			)
		formatString: #,0
		displayFolder: KPIs\Support
		lineageTag: 4a8c5f0e-7a9b-4cd3-94e5-8a9b0c1d2e75

	/// Share of competed awards (base action in context, extent competed A, D, F or CDO, 1+ offers reported) that received exactly one offer.
	/// A standard indicator of how much effective competition competed contracts attract.
	measure 'Single-Offer Rate' = DIVIDE ( [Single-Offer Awards], [Single-Offer Eligible Awards] )
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 6c0e7a2b-9c1d-4ef5-b6a7-0c1d2e3f4a76

	/// Recipient identity = parent UEI (company family; a recipient with no reported parent is its own parent).
	/// Net Obligations of the 10 parent UEIs with the highest Net Obligations in context / Net Obligations of all recipients
	/// in context (recipient filters removed). Ties at rank 10 can include more than 10 parents.
	measure 'Top 10 Recipient Share' =
			VAR ParentNet =
			    ADDCOLUMNS ( VALUES ( DimRecipient[Parent UEI] ), "@Net", [Net Obligations] )
			VAR Top10Net =
			    SUMX ( TOPN ( 10, ParentNet, [@Net], DESC ), [@Net] )
			VAR AllRecipientsNet =
			    CALCULATE ( [Net Obligations], REMOVEFILTERS ( DimRecipient ) )
			RETURN
			    DIVIDE ( Top10Net, AllRecipientsNet )
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 8e2a9c4d-1e3f-4a07-98b9-2e3f4a5b6c77

	/// Text label of the fiscal year(s) in context for titles: "FY2025", "FY2023-FY2025" (contiguous) or "FY2023, FY2025".
	measure 'Selected FY Label' =
			VAR MinFY = MIN ( DimDate[Fiscal Year Number] )
			VAR MaxFY = MAX ( DimDate[Fiscal Year Number] )
			VAR FYCount = DISTINCTCOUNT ( DimDate[Fiscal Year Number] )
			RETURN
			    SWITCH (
			        TRUE (),
			        FYCount = 1, "FY" & MinFY,
			        MaxFY - MinFY + 1 = FYCount, "FY" & MinFY & "-FY" & MaxFY,
			        CONCATENATEX ( VALUES ( DimDate[Fiscal Year Number] ), "FY" & DimDate[Fiscal Year Number], ", ", DimDate[Fiscal Year Number], ASC )
			    )
		displayFolder: KPIs
		lineageTag: 0a4c1e6f-3a5b-4c29-ba1d-4a5b6c7d8e78

	/// New Awards definition check: awards with more than one base action. Expected 0.
	measure 'DQ Awards With Multiple Base Actions' =
			COUNTROWS (
			    FILTER (
			        VALUES ( FactContractTransactions[Award Key] ),
			        CALCULATE ( COUNTROWS ( FactContractTransactions ), FactContractTransactions[Is Base Action] = TRUE () ) > 1
			    )
			) + 0
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 2c6e3a8b-5c7d-4e4b-9c3f-6c7d8e9f0a79

	/// New Awards definition check: base actions that carry an action type (base actions should have none). Expected 0.
	measure 'DQ Base Actions With Action Type' =
			CALCULATE (
			    COUNTROWS ( FactContractTransactions ),
			    FactContractTransactions[Is Base Action] = TRUE (),
			    DimContractType[Action Type Code] <> ""
			) + 0
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 4e8a5c0d-7e9f-4a6d-ae51-8e9f0a1b2c80

	/// Net obligations recorded on qualifying base award actions (Is Base Action = TRUE) in context: the obligation booked
	/// when the award was signed. NOT the award's lifetime, current or potential value. New + Continuing = Net Obligations.
	measure 'New Award Obligations' =
			CALCULATE (
			    [Net Obligations],
			    FactContractTransactions[Is Base Action] = TRUE ()
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Report
		lineageTag: 5d1b7e3a-2c4f-4a8e-9b61-7e3a2c4f5a81

	/// Net obligations recorded on modifications of existing awards (options, funding actions, changes, close-outs, de-obligations).
	measure 'Continuing Award Obligations' =
			CALCULATE (
			    [Net Obligations],
			    FactContractTransactions[Is Base Action] = FALSE ()
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Report
		lineageTag: 6e2c8f4b-3d5a-4b9f-8c72-8f4b3d5a6b82

	/// Report subtitle: fiscal years in context plus the obligations-vs-outlays definition shown on every page.
	measure 'Report Subtitle' = [Selected FY Label] & "  ·  Net obligations = binding commitments net of de-obligations, not outlays (payments)"
		displayFolder: Report
		lineageTag: 7f3d9a5c-4e6b-4ca0-9d83-9a5c4e6b7c83

	/// Card caption for Net Obligations YoY %. Shows a comparison only when exactly one fiscal year with a prior year in the dataset is in context.
	measure 'YoY Label' =
			VAR Pct = [Net Obligations YoY %]
			VAR FY = MAX ( DimDate[Fiscal Year Number] )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT HASONEVALUE ( DimDate[Fiscal Year Number] ), "Select one fiscal year to compare",
			        ISBLANK ( Pct ), "No prior fiscal year in dataset",
			        IF ( Pct >= 0, "▲ +", "▼ " ) & FORMAT ( Pct, "0.0%" ) & " vs FY" & ( FY - 1 )
			    )
		displayFolder: Report
		lineageTag: 8a4e0b6d-5f7c-4db1-ae94-0b6d5f7c8d84

	/// Card caption for Deobligations: de-obligation rate for the period in context, e.g. "9.3% de-obligation rate".
	/// Blank when there are no transactions. "0.0%" when there is activity and gross obligations but no de-obligations.
	/// When gross obligations are zero (only de-obligations or zero-dollar actions) the rate is undefined and says so.
	measure 'Deob Rate Label' =
			VAR Rate = [Deobligation Rate]
			VAR Gross = [Gross Obligations]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [Transactions] ), BLANK (),
			        ISBLANK ( Gross ) || Gross = 0, "Rate n/a: no positive obligations",
			        FORMAT ( COALESCE ( Rate, 0 ), "0.0%" ) & " de-obligation rate"
			    )
		displayFolder: Report
		lineageTag: 9b5f1c7e-6a8d-4ec2-bfa5-1c7e6a8d9e85

	/// Conditional-formatting color for Net Obligations: blue when >= 0, rust when negative (sign preserved).
	measure 'Net Obligations Color' = IF ( [Net Obligations] < 0, "#C8553D", "#2A6BC2" )
		displayFolder: Report
		lineageTag: ac602d8f-7b9e-4fd3-80b6-2d8f7b9eaf86

	/// Footer text: data source, extract date and the obligations-vs-outlays caveat.
	measure 'Data Source Label' = "Source: USAspending.gov · DHS prime contract transactions, FY2023–FY2025 · extract downloaded 2026-10-09 · Obligations are legal commitments to pay; they are not expenditures (outlays)."
		displayFolder: Report
		lineageTag: bd713e90-8caf-4ae4-91c7-3e908cafb087

	/// Display-only: Net Obligations in billions of dollars (numeric; value / 1,000,000,000). Shown as $23.90B, negatives as ($1.79B).
	/// Use for cards, tables and chart labels; calculations and sorting logic stay on Net Obligations.
	measure 'Net Obligations ($B)' = DIVIDE ( [Net Obligations], 1000000000 )
		formatString: \$#,0.00\B;(\$#,0.00\B);\$#,0.00\B
		displayFolder: Report\Display ($B)
		lineageTag: c1824fa1-9dbe-4bf5-a2c7-4fa19dbe5c91

	/// Display-only: Gross Obligations in billions of dollars (numeric).
	measure 'Gross Obligations ($B)' = DIVIDE ( [Gross Obligations], 1000000000 )
		formatString: \$#,0.00\B;(\$#,0.00\B);\$#,0.00\B
		displayFolder: Report\Display ($B)
		lineageTag: d2935ab2-aeac-4c06-b3e9-5ab2aeacd692

	/// Display-only: Deobligations in billions of dollars (numeric, keeps the negative sign; shown in parentheses).
	measure 'Deobligations ($B)' = DIVIDE ( [Deobligations], 1000000000 )
		formatString: \$#,0.00\B;(\$#,0.00\B);\$#,0.00\B
		displayFolder: Report\Display ($B)
		lineageTag: e3a46bc3-bfbd-4d17-84a5-6bc3bfbde793

	/// Display-only: New Award Obligations (obligations on base award actions) in billions of dollars (numeric).
	measure 'New Award Obligations ($B)' = DIVIDE ( [New Award Obligations], 1000000000 )
		formatString: \$#,0.00\B;(\$#,0.00\B);\$#,0.00\B
		displayFolder: Report\Display ($B)
		lineageTag: f4b57cd4-c0bd-4e28-95a3-7cd4c0bdf894

	/// Card caption for New Awards: obligations on new base awards in context, e.g. "$34.14B on new awards" (same $B format as the report).
	measure 'New Award Obligations Label' =
			VAR Amt = [New Award Obligations ($B)]
			RETURN
			    IF ( NOT ISBLANK ( Amt ), FORMAT ( Amt, "\$#,0.00\B;(\$#,0.00\B)" ) & " on new awards" )
		displayFolder: Report
		lineageTag: a5c68de5-d1ce-4f39-a6b4-8de5d1cef0a5

	/// Distinct parent companies (Parent UEI) with at least one transaction in context. A recipient with no reported
	/// parent UEI is its own parent. The fact-table filter restricts the count to parents with activity.
	measure 'Parent Companies' = CALCULATE ( DISTINCTCOUNT ( DimRecipient[Parent UEI] ), FactContractTransactions )
		formatString: #,0
		displayFolder: Recipients
		lineageTag: 6b1f2e8d-4c3a-4e57-9a0b-1d2e3f4a5b61

	/// Card caption: "12,835 parent companies" for the period in context.
	measure 'Parent Companies Label' =
			VAR N = [Parent Companies]
			RETURN
			    IF ( NOT ISBLANK ( N ), FORMAT ( N, "#,0" ) & " parent companies" )
		displayFolder: Report
		lineageTag: 7c2a3f9e-5d4b-4f68-8b1c-2e3f4a5b6c72

	/// Distinct recipient UEIs with at least one action where the contracting officer determined the business is small (size code S).
	/// A recipient can also have other-than-small actions; it is counted here if any action in context is small-business.
	measure 'Small Business Recipients' = CALCULATE ( [Recipients], DimContractType[Small Business Flag] = "Small Business" )
		formatString: #,0
		displayFolder: Recipients
		lineageTag: 8d3b4a0f-6e5c-4a79-9c2d-3f4a5b6c7d83

	/// Card caption: "9,805 small-business recipients" for the period in context.
	measure 'Small Business Recipients Label' =
			VAR N = [Small Business Recipients]
			RETURN
			    IF ( NOT ISBLANK ( N ), FORMAT ( N, "#,0" ) & " small-business recipients" )
		displayFolder: Report
		lineageTag: 9e4c5b1a-7f6d-4b8a-ad3e-4a5b6c7d8e94

	/// Net Obligations divided by the number of recipient UEIs with activity in context (can be negative).
	measure 'Avg Net Obligation per Recipient' = DIVIDE ( [Net Obligations], [Recipients] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Recipients
		lineageTag: af5d6c2b-8a7e-4c9b-be4f-5b6c7d8e9fa5

	/// Rank (1 = highest Net Obligations) of a recipient UEI among the UEIs in the visual's selection.
	/// Identity = Recipient UEI (DimRecipient has one row per UEI), so recipients sharing a name are ranked separately.
	/// ALLSELECTED ( DimRecipient ) restores every recipient column to the visual's outer selection, so the row's other
	/// grouping columns (name, parent, HQ state) do not narrow the comparison set, while slicers still apply.
	/// Only UEIs with activity are compared, so negative-net recipients rank last but are kept and are never pushed
	/// down by inactive UEIs. Blank unless Recipient UEI is on the visual and has activity. Ties share a rank (SKIP).
	/// (A RANK window-function version failed with out-of-memory errors when the visual grouped by several recipient columns.)
	measure 'Recipient Rank (UEI)' =
			VAR CurrentNet = [Net Obligations]
			RETURN
			    IF (
			        ISINSCOPE ( DimRecipient[Recipient UEI] ) && NOT ISBLANK ( CurrentNet ),
			        CALCULATE (
			            RANKX (
			                FILTER ( VALUES ( DimRecipient[Recipient UEI] ), NOT ISBLANK ( [Net Obligations] ) ),
			                [Net Obligations],
			                CurrentNet,
			                DESC,
			                SKIP
			            ),
			            ALLSELECTED ( DimRecipient )
			        )
			    )
		formatString: #,0
		displayFolder: Recipients
		lineageTag: b06e7d3c-9b8f-4dac-8f50-6c7d8e9fa0b6

	/// Header text for the Transaction Detail drill-through page: the recipient (with UEI) or parent company passed in.
	measure 'Transaction Detail Context' =
			VAR U = SELECTEDVALUE ( DimRecipient[Recipient UEI] )
			VAR P = SELECTEDVALUE ( DimRecipient[Parent Company] )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( U ), "Recipient: " & SELECTEDVALUE ( DimRecipient[Recipient Name] ) & "  ·  UEI " & U,
			        NOT ISBLANK ( P ), "Parent company: " & P & "  ·  " & FORMAT ( [Recipients], "#,0" ) & " recipient UEIs",
			        "All recipients in the current filters"
			    )
		displayFolder: Report
		lineageTag: c17f8e4d-0c9a-4ebd-a061-7d8e9fa0b1c7

	/// Display-only: Deobligations, or $0 when the selection has transactions but no de-obligations. Blank when there is
	/// no activity. Negative values are kept as-is. Calculations stay on Deobligations.
	measure 'Deobligations (display)' = IF ( NOT ISBLANK ( [Transactions] ), COALESCE ( [Deobligations], 0 ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Report
		lineageTag: d28a9f5e-1dab-4fce-b172-8e9fa0b1c2d8

	/// Display-only: New Awards, or 0 when the selection has transactions but no base award actions. Blank when there is no activity.
	measure 'New Awards (display)' = IF ( NOT ISBLANK ( [Transactions] ), COALESCE ( [New Awards], 0 ) )
		formatString: #,0
		displayFolder: Report
		lineageTag: e39ba06f-2ebc-4adf-8c83-9fa0b1c2d3e9

	/// Card caption in full dollars for detail pages, e.g. "$12,345,678 on new awards" or "$0 on new awards".
	/// Blank when there is no activity.
	measure 'New Award Obligations Label ($)' =
			IF (
			    NOT ISBLANK ( [Transactions] ),
			    FORMAT ( COALESCE ( [New Award Obligations], 0 ), "\$#,0;(\$#,0);\$0" ) & " on new awards"
			)
		displayFolder: Report
		lineageTag: f4acb17a-3fcd-4be0-9d94-a0b1c2d3e4fa

	/// Card text for Small Business Share. "n/a" when net obligations are zero or negative (a share of a non-positive
	/// total is not meaningful); "0.0%" when net is positive but there are no small-business obligations; blank with
	/// no activity. Text so the card can show "n/a"; the calculation stays on Small Business Share.
	measure 'Small Business Share (display)' =
			VAR NetObl = [Net Obligations]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [Transactions] ), BLANK (),
			        ISBLANK ( NetObl ) || NetObl <= 0, "n/a",
			        FORMAT ( COALESCE ( [Small Business Share], 0 ), "0.0%" )
			    )
		displayFolder: Report
		lineageTag: a6bdc28b-40de-4cf1-8ea5-b1c2d3e4f50b

	/// Card caption for Small Business Share: number of small-business recipients (0 when none), or why the share is n/a.
	measure 'Small Business Share Caption' =
			VAR NetObl = [Net Obligations]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [Transactions] ), BLANK (),
			        ISBLANK ( NetObl ) || NetObl <= 0, "Share n/a: net obligations ≤ $0",
			        FORMAT ( COALESCE ( [Small Business Recipients], 0 ), "#,0" ) & " small-business recipients"
			    )
		displayFolder: Report
		lineageTag: b7ced39c-51ef-4d02-9fb6-c2d3e4f5061c

	/// Card text for Top 10 Recipient Share. "n/a" whenever recipients are filtered (recipient search, or a parent or
	/// recipient selected in a chart or table): concentration across vendors is not meaningful for a selected vendor.
	/// DimRecipient is filtered only by recipient selections (single-direction relationship), so fiscal-year,
	/// DHS component and NAICS filters keep the numeric share. Text so the card can show "n/a".
	measure 'Top 10 Share (display)' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Transactions] ), BLANK (),
			    ISCROSSFILTERED ( DimRecipient ), "n/a",
			    FORMAT ( [Top 10 Recipient Share], "0.0%" )
			)
		displayFolder: Report
		lineageTag: c8dfe4ad-62f0-4e13-a0a7-d3e4f506172d

	/// Card caption for Top 10 Recipient Share: what the share covers, or why it is n/a.
	measure 'Top 10 Share Caption' =
			SWITCH (
			    TRUE (),
			    ISBLANK ( [Transactions] ), BLANK (),
			    ISCROSSFILTERED ( DimRecipient ), "Recipient filter applied",
			    "Top 10 parent companies by Parent UEI"
			)
		displayFolder: Report
		lineageTag: d9e0f5be-7301-4f24-b1b8-e4f5061728e3

	/// Card text for Avg Net Obligation per Recipient, scaled to K, M or B (e.g. $5.61M, $3.13B); negatives in
	/// parentheses; $0 for zero; blank when there is no value. The exact amount stays in Avg Net Obligation per Recipient.
	measure 'Avg Net Obligation per Recipient (display)' =
			VAR v = [Avg Net Obligation per Recipient]
			VAR a = ABS ( v )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( v ), BLANK (),
			        a >= 1e9, FORMAT ( v / 1e9, "\$#,0.00\B;(\$#,0.00\B)" ),
			        a >= 1e6, FORMAT ( v / 1e6, "\$#,0.00\M;(\$#,0.00\M)" ),
			        a >= 1e3, FORMAT ( v / 1e3, "\$#,0.0\K;(\$#,0.0\K)" ),
			        FORMAT ( v, "\$#,0;(\$#,0)" )
			    )
		displayFolder: Report
		lineageTag: e4a1f2b3-8c5d-4e6f-9a07-b1c2d3e4f5a6

	/// Change in Net Obligations vs. the prior fiscal year, in billions (numeric). Blank unless one fiscal year with a prior year is in context.
	/// Same $B approach as the other display measures (fixed decimal: $100,000 precision); shown as +$4.73B / -$0.29B.
	measure 'Net Obligations YoY ($B)' = DIVIDE ( [Net Obligations YoY], 1000000000 )
		formatString: +\$#,0.00\B;-\$#,0.00\B;\$0.00\B
		displayFolder: Report\Display ($B)
		lineageTag: 1a7c3e9b-2d4f-4a6b-8c1e-3f5a7b9c1d21

	/// Card text for Net Obligations YoY ($B): "+$4.73B" / "-$0.29B", same rounding as the numeric measure; "N/A" when there
	/// is no prior-year comparison (FY2023, or no single fiscal year selected). The sign comes from the unrounded value, so a
	/// change under $5M still shows its direction (+$0.00B / -$0.00B). Text so the card can show "N/A"; charts and
	/// calculations stay on Net Obligations YoY ($B).
	measure 'Net Obligations YoY ($B) (display)' =
			VAR v = [Net Obligations YoY ($B)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( v ), "N/A",
			        v = 0, "$0.00B",
			        IF ( v > 0, "+", "-" ) & FORMAT ( ABS ( v ), "\$#,0.00\B" )
			    )
		displayFolder: Report
		lineageTag: 5de5d244-638b-4d0d-9e77-e760db23a97a

	/// Net Obligations for the same period one fiscal year earlier, in billions (numeric), for the monthly prior-year line on the $B axis.
	measure 'Net Obligations PY ($B)' = DIVIDE ( [Net Obligations PY], 1000000000 )
		formatString: \$#,0.00\B;(\$#,0.00\B);\$#,0.00\B
		displayFolder: Report\Display ($B)
		lineageTag: 2b8d4fac-3e5a-4b7c-9d2f-4a6b8cad2e32

	/// Share of the fiscal year's net obligations recorded in September (fiscal month 12), the fiscal year-end surge.
	/// Ignores month, quarter and date filters but keeps the fiscal year(s) and all non-date filters. Blank when net is not positive.
	measure 'Year-End Share' =
			VAR FiscalYearNet =
			    CALCULATE ( [Net Obligations], ALLEXCEPT ( DimDate, DimDate[Fiscal Year Number], DimDate[Fiscal Year] ) )
			VAR SeptemberNet =
			    CALCULATE (
			        [Net Obligations],
			        ALLEXCEPT ( DimDate, DimDate[Fiscal Year Number], DimDate[Fiscal Year] ),
			        DimDate[Fiscal Month Number] = 12
			    )
			RETURN
			    IF ( FiscalYearNet > 0, DIVIDE ( SeptemberNet, FiscalYearNet ) )
		formatString: 0.0%
		displayFolder: Agency
		lineageTag: 3c9e5abd-4f6b-4c8d-ae3a-5b7c9dbe3f43

	/// Awarding offices (DimAgency rows, office grain) with at least one transaction in context. Awarding agency, not funding agency.
	measure 'Awarding Offices' = CALCULATE ( DISTINCTCOUNT ( DimAgency[AgencyKey] ), FactContractTransactions )
		formatString: #,0
		displayFolder: Agency
		lineageTag: 4dafa6ce-5a7c-4d9e-bf4b-6c8daecf4a54

	/// DHS awarding components (sub-agencies) with at least one transaction in context.
	measure 'Active Components' = CALCULATE ( DISTINCTCOUNT ( DimAgency[Sub-Agency Name] ), FactContractTransactions )
		formatString: #,0
		displayFolder: Agency
		lineageTag: 5eb0b7df-6b8d-4eaf-80c5-7d9ebfd05b65

	/// Card caption for Awarding Offices, e.g. "across 10 DHS components".
	measure 'Awarding Offices Label' =
			VAR N = [Active Components]
			RETURN IF ( NOT ISBLANK ( N ), "across " & FORMAT ( N, "#,0" ) & " DHS components" )
		displayFolder: Report
		lineageTag: 6fc1c8e0-7c9e-4fb0-91d6-8eafc0e16c76

	/// Conditional-formatting color for year-over-year change: teal for growth, rust for decline; blank when there is no comparison.
	measure 'YoY Change Color' =
			VAR Chg = [Net Obligations YoY]
			RETURN IF ( NOT ISBLANK ( Chg ), IF ( Chg < 0, "#C8553D", "#13A398" ) )
		displayFolder: Report
		lineageTag: 7ad2d9f1-8daf-4ac1-a2e7-9fb0d1f27d87

	/// Competed Share for matrix rows (net-based, same definition as Competed Share).
	/// Blank when net obligations are zero or negative, or when the share falls outside 0-100% (e.g. an office whose only
	/// actions in the category are de-obligations on older awards). 0% and 100% are kept. Numeric, so sorting works.
	measure 'Competed Share (positive net)' =
			VAR NetObl = [Net Obligations]
			VAR Share = [Competed Share]
			RETURN
			    IF ( NetObl > 0 && Share >= 0 && Share <= 1, Share )
		formatString: 0.0%
		displayFolder: Mix\Safe (positive net)
		lineageTag: 8be3ea02-9eb0-4bd2-b3f8-a0c1e2038e98

	/// Small Business Share for matrix rows (net-based, same definition as Small Business Share).
	/// Blank when net obligations are zero or negative, or when the share falls outside 0-100% (e.g. an office whose only
	/// actions in the category are de-obligations on older awards). 0% and 100% are kept. Numeric, so sorting works.
	measure 'Small Business Share (positive net)' =
			VAR NetObl = [Net Obligations]
			VAR Share = [Small Business Share]
			RETURN
			    IF ( NetObl > 0 && Share >= 0 && Share <= 1, Share )
		formatString: 0.0%
		displayFolder: Mix\Safe (positive net)
		lineageTag: 9cf4fb13-afc1-4ce3-84a9-b1d2f3149fa9

	/// Net Obligations YoY %, blank when prior-year net obligations are zero, negative or absent (a % change from a non-positive base is meaningless).
	measure 'Net Obligations YoY % (positive PY)' = IF ( [Net Obligations PY] > 0, [Net Obligations YoY %] )
		formatString: 0.0%
		displayFolder: Mix\Safe (positive net)
		lineageTag: ad05ac24-b0d2-4df4-95ba-c2e3a425a0ba

	column Placeholder
		dataType: string
		isHidden
		lineageTag: 765109ba-81ab-444b-9d38-a04a4d1feadd
		summarizeBy: none
		sourceColumn: Placeholder

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Placeholder = text], {})
				in
				    Source

	annotation PBI_ResultType = Table

